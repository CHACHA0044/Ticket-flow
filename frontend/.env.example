# ─────────────────────────────────────────────────────────────
# Ticket Flow — Frontend Environment Template
# Copy to `.env.local` for local development:  cp .env.example .env.local
# NEVER commit a real `.env.local` or any credential file.
# ─────────────────────────────────────────────────────────────

# Base URL of the Ticket Flow REST API (Node/Express backend).
# Leave EMPTY to run the app entirely on the in-memory mock data layer.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Base URL used for the Socket.io connection (wss:// in production).
# Leave EMPTY to run the built-in simulated real-time seat simulator.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Set to "true" to enable the simulated real-time seat feed in development.
# Automatically disabled once a real NEXT_PUBLIC_SOCKET_URL is provided.
NEXT_PUBLIC_ENABLE_MOCK_REALTIME=true

# Absolute origin used for canonical URLs / Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── TEST-MODE PAYMENT SANDBOX ─────────────────────────────────
# Publishable test-mode key only (Stripe/Razorpay sandbox).
# This project ships a mock checkout; the key is a placeholder.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder